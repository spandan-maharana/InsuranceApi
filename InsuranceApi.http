###############################################################
# SETTINGS
###############################################################
@host = https://localhost:7073

# Quote start date: always one year from today, so it is never in the past
@effectiveDate = {{$datetime "yyyy-MM-dd" 1 y}}


###############################################################
# LOGIN FIRST. Everything below needs these three tokens.
# Tokens last 1 hour.
###############################################################

###  Login as agent (expect 200, returns a token)
# @name agentLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "agent", "password": "Agent123!" }

### Login as SuperUser (expect 200, role says SuperUser)
# @name superLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "superuser", "password": "User123!" }

### 29. Login as underwriter (expect 200, role says Underwriter)
# @name underLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "underwriter", "password": "Underwriter123!" }


###############################################################
# PRODUCT CATALOGUE (public, no token needed)
###############################################################

### 62. All categories with their products (expect 200, 4 categories, 15 products in total)
GET {{host}}/api/categories

### 63. One product with its questions (expect 200, AUTO has 3 questions)
GET {{host}}/api/products/AUTO

### 64. Product that does not exist (expect 404)
GET {{host}}/api/products/BOAT

### 65. Another product, to see that every product has its own questions (expect 200, HOME)
GET {{host}}/api/products/HOME


###############################################################
# CUSTOMERS
###############################################################

### 1. Create a customer (expect 201)
# @name newCustomer
POST {{host}}/api/customers
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "firstName": "Ana",
  "lastName": "Smith",
  "email": "ana-{{$guid}}@test.com",
  "phoneNumber": "603-555-0101"
}

### 2. Get all customers (expect 200)
GET {{host}}/api/customers
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 3. Get one customer (expect 200)
GET {{host}}/api/customers/{{newCustomer.response.body.$.id}}
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 4. Update a customer (expect 200)
PUT {{host}}/api/customers/{{newCustomer.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "firstName": "Ana",
  "lastName": "Johnson",
  "email": "{{newCustomer.response.body.$.email}}",
  "phoneNumber": "603-555-0101"
}

### 5. Bad email (expect 400)
POST {{host}}/api/customers
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "firstName": "Bob",
  "lastName": "Lee",
  "email": "not-an-email",
  "phoneNumber": "603-555-0102"
}

### 6. Missing phone (expect 400)
POST {{host}}/api/customers
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "firstName": "Bob",
  "lastName": "Lee",
  "email": "bob@test.com"
}

### 7. Duplicate email (expect 409)
POST {{host}}/api/customers
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "firstName": "Ana",
  "lastName": "Two",
  "email": "{{newCustomer.response.body.$.email}}",
  "phoneNumber": "603-555-0103"
}

### 8. Not found (expect 404)
GET {{host}}/api/customers/999
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 9. Delete (expect 204). Needs the SuperUser token.
DELETE {{host}}/api/customers/{{newCustomer.response.body.$.id}}
Authorization: Bearer {{superLogin.response.body.$.token}}


###############################################################
# LOGIN AND ROLE TESTS
###############################################################

### 10. No token (expect 401)
GET {{host}}/api/customers

### 11. Wrong password (expect 401)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "superuser", "password": "wrong" }

### 13. Agent creates a customer with the token (expect 201)
# @name created
POST {{host}}/api/customers
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "firstName": "Maya",
  "lastName": "Patel",
  "email": "maya-{{$guid}}@test.com",
  "phoneNumber": "603-555-0111"
}

### 14. Agent reads customers (expect 200)
GET {{host}}/api/customers
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 15. Agent tries to delete (expect 403)
DELETE {{host}}/api/customers/{{created.response.body.$.id}}
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 17. SuperUser deletes (expect 204)
DELETE {{host}}/api/customers/{{created.response.body.$.id}}
Authorization: Bearer {{superLogin.response.body.$.token}}

### 18. SuperUser creates a customer (expect 201)
POST {{host}}/api/customers
Content-Type: application/json
Authorization: Bearer {{superLogin.response.body.$.token}}

{
  "firstName": "Priya",
  "lastName": "Nair",
  "email": "priya-{{$guid}}@test.com",
  "phoneNumber": "603-555-0133"
}

### 19. SuperUser reads customers (expect 200)
GET {{host}}/api/customers
Authorization: Bearer {{superLogin.response.body.$.token}}


###############################################################
# QUOTES (every quote now has a productCode and answers)
###############################################################

### 20. Create a customer to quote for (expect 201)
# @name quoteCustomer
POST {{host}}/api/customers
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "firstName": "Sam",
  "lastName": "Rivera",
  "email": "sam-{{$guid}}@test.com",
  "phoneNumber": "603-555-0122"
}

### 21. Create an Auto quote (expect 201, status Draft, premium null, answers saved)
# @name newQuote
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 80000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": {
    "driverAge": 40,
    "accidentsLast3Years": 0,
    "vehicleType": "Sedan"
  }
}

### 22. Get that quote (expect 200)
GET {{host}}/api/quotes/{{newQuote.response.body.$.id}}
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 23. Get all quotes (expect 200)
GET {{host}}/api/quotes
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 24. No token (expect 401)
GET {{host}}/api/quotes

### 25. Date in the past (expect 400)
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 50000,
  "requestedEffectiveDate": "2020-01-01",
  "answers": { "driverAge": 40, "accidentsLast3Years": 0, "vehicleType": "Sedan" }
}

### 26. Customer does not exist (expect 404)
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": 99999,
  "productCode": "AUTO",
  "coverageAmount": 50000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": { "driverAge": 40, "accidentsLast3Years": 0, "vehicleType": "Sedan" }
}

### 27. Unknown product (expect 400, "Unknown or unavailable product.")
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "BOAT",
  "coverageAmount": 50000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": {}
}

### 28. Coverage too small for Auto (expect 400, must be between 10,000 and 500,000)
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 5000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": { "driverAge": 40, "accidentsLast3Years": 0, "vehicleType": "Sedan" }
}

### 66. Coverage too big for Auto (expect 400, must be between 10,000 and 500,000)
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 900000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": { "driverAge": 40, "accidentsLast3Years": 0, "vehicleType": "Sedan" }
}

### 67. A required answer is missing (expect 400, says the accidents answer is required)
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 50000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": { "driverAge": 40, "vehicleType": "Sedan" }
}

### 68. An answer that is not a question for Auto (expect 400)
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 50000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": { "driverAge": 40, "accidentsLast3Years": 0, "vehicleType": "Sedan", "roofType": "Tile" }
}

### 69. Driver age out of range (expect 400, must be between 16 and 100)
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 50000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": { "driverAge": 12, "accidentsLast3Years": 0, "vehicleType": "Sedan" }
}

### 70. Vehicle type is not in the list (expect 400, must be one of: Sedan, SUV, Truck, Sports car)
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 50000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": { "driverAge": 40, "accidentsLast3Years": 0, "vehicleType": "Tank" }
}

### 71. Age is not a number (expect 400, must be a number)
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 50000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": { "driverAge": "abc", "accidentsLast3Years": 0, "vehicleType": "Sedan" }
}


###############################################################
# QUOTE LIFECYCLE (agent sells, underwriter approves)
###############################################################

### 30. Create a quote (expect 201, status Draft, premium null)
# @name lifeQuote
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 80000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": { "driverAge": 40, "accidentsLast3Years": 0, "vehicleType": "Sedan" }
}

### 31. Underwriter binds a Draft (expect 409, wrong status)
POST {{host}}/api/quotes/{{lifeQuote.response.body.$.id}}/bind
Authorization: Bearer {{underLogin.response.body.$.token}}

### 32. Agent accepts a Draft (expect 409, must be Quoted first)
POST {{host}}/api/quotes/{{lifeQuote.response.body.$.id}}/accept
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 33. Agent gives the quote (expect 200, status Quoted, premium 1130.00, premiumBreakdown with steps, expiresAt set)
POST {{host}}/api/quotes/{{lifeQuote.response.body.$.id}}/quote
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 34. Quote it again (expect 409, already Quoted)
POST {{host}}/api/quotes/{{lifeQuote.response.body.$.id}}/quote
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 35. SuperUser tries to accept (expect 403, admin does not do insurance work)
POST {{host}}/api/quotes/{{lifeQuote.response.body.$.id}}/accept
Authorization: Bearer {{superLogin.response.body.$.token}}

### 36. Agent accepts (expect 200, status Accepted)
POST {{host}}/api/quotes/{{lifeQuote.response.body.$.id}}/accept
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 37. Agent tries to bind (expect 403, underwriter only)
POST {{host}}/api/quotes/{{lifeQuote.response.body.$.id}}/bind
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 38. Underwriter issues too early (expect 409, must be Bound first)
POST {{host}}/api/quotes/{{lifeQuote.response.body.$.id}}/issue
Authorization: Bearer {{underLogin.response.body.$.token}}

### 39. Underwriter binds (expect 200, status Bound)
POST {{host}}/api/quotes/{{lifeQuote.response.body.$.id}}/bind
Authorization: Bearer {{underLogin.response.body.$.token}}

### 40. Underwriter issues (expect 200, status Issued, a policy is created)
POST {{host}}/api/quotes/{{lifeQuote.response.body.$.id}}/issue
Authorization: Bearer {{underLogin.response.body.$.token}}

### 41. Discard an Issued quote (expect 409, too late)
POST {{host}}/api/quotes/{{lifeQuote.response.body.$.id}}/discard
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 42. Quote that does not exist (expect 404)
POST {{host}}/api/quotes/99999/accept
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 43. Rejection path: create a riskier Auto quote (expect 201, Draft)
# @name rejectQuote
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 80000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": { "driverAge": 20, "accidentsLast3Years": 2, "vehicleType": "Sports car" }
}

### 44. Agent gives the quote (expect 200, Quoted, premium 4754.00)
POST {{host}}/api/quotes/{{rejectQuote.response.body.$.id}}/quote
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 45. Agent accepts (expect 200, Accepted)
POST {{host}}/api/quotes/{{rejectQuote.response.body.$.id}}/accept
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 46. Underwriter rejects with Discard (expect 200, status Discarded)
POST {{host}}/api/quotes/{{rejectQuote.response.body.$.id}}/discard
Authorization: Bearer {{underLogin.response.body.$.token}}

### 47. Accept a Discarded quote (expect 409)
POST {{host}}/api/quotes/{{rejectQuote.response.body.$.id}}/accept
Authorization: Bearer {{agentLogin.response.body.$.token}}


###############################################################
# POLICIES
###############################################################

### 48. Create a quote for the policy test (expect 201, Draft)
# @name policyQuote
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "AUTO",
  "coverageAmount": 80000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": { "driverAge": 40, "accidentsLast3Years": 0, "vehicleType": "Sedan" }
}

### 49. Agent gives the quote (expect 200, Quoted)
POST {{host}}/api/quotes/{{policyQuote.response.body.$.id}}/quote
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 50. Agent accepts (expect 200, Accepted)
POST {{host}}/api/quotes/{{policyQuote.response.body.$.id}}/accept
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 51. Underwriter binds (expect 200, Bound)
POST {{host}}/api/quotes/{{policyQuote.response.body.$.id}}/bind
Authorization: Bearer {{underLogin.response.body.$.token}}

### 52. Underwriter issues (expect 200, Issued, and a policy is created)
POST {{host}}/api/quotes/{{policyQuote.response.body.$.id}}/issue
Authorization: Bearer {{underLogin.response.body.$.token}}

### 53. Get the policy created from that quote (expect 200, Issued, term 0, productCode AUTO, premium 1130.00)
# @name policyByQuote
GET {{host}}/api/policies/by-quote/{{policyQuote.response.body.$.id}}
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 53b. List all policies (expect 200)
GET {{host}}/api/policies
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 54. Agent renews (expect 200, term 1, effective one year after the original)
POST {{host}}/api/policies/{{policyByQuote.response.body.$.id}}/renew
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 55. Renew the same policy again (expect 409, already renewed)
POST {{host}}/api/policies/{{policyByQuote.response.body.$.id}}/renew
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 56. Search by segment (expect 200, two policies: term 0 and term 1)
GET {{host}}/api/policies?segment={{policyByQuote.response.body.$.segment}}
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 57. Underwriter tries to cancel (expect 403, agent only)
POST {{host}}/api/policies/{{policyByQuote.response.body.$.id}}/cancel
Authorization: Bearer {{underLogin.response.body.$.token}}

### 58. Agent cancels the original policy (expect 200, Cancelled, cancelledAt set)
POST {{host}}/api/policies/{{policyByQuote.response.body.$.id}}/cancel
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 59. Cancel it again (expect 409)
POST {{host}}/api/policies/{{policyByQuote.response.body.$.id}}/cancel
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 60. Renew a cancelled policy (expect 409)
POST {{host}}/api/policies/{{policyByQuote.response.body.$.id}}/renew
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 61. Policy that does not exist (expect 404)
GET {{host}}/api/policies/99999
Authorization: Bearer {{agentLogin.response.body.$.token}}



###############################################################
# ADMIN: PRODUCT MANAGEMENT (SuperUser only)
###############################################################

### 72. SuperUser lists all products (expect 200, 15 or more products, with rates and fees shown)
GET {{host}}/api/admin/products
Authorization: Bearer {{superLogin.response.body.$.token}}

### 73. Agent tries to list (expect 403)
GET {{host}}/api/admin/products
Authorization: Bearer {{agentLogin.response.body.$.token}}

### 74. No token (expect 401)
GET {{host}}/api/admin/products

### 75. SuperUser creates a product (expect 201, isActive true, questionCount 0)
# @name newProduct
POST {{host}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{superLogin.response.body.$.token}}

{
  "code": "TEST_{{$randomInt 100000 999999}}",
  "categoryCode": "SPECIALIZED",
  "name": "Test Bike Insurance",
  "description": "Theft and damage cover for bicycles.",
  "coverageLabel": "Bike value",
  "ratePerThousand": 8,
  "minimumPremium": 100,
  "policyFee": 20,
  "minCoverage": 500,
  "maxCoverage": 20000,
  "sortOrder": 99
}

### 76. Get that product (expect 200)
GET {{host}}/api/admin/products/{{newProduct.response.body.$.code}}
Authorization: Bearer {{superLogin.response.body.$.token}}

