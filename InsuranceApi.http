  "maxCoverage": 25000,
  "sortOrder": 99
}

### 85. Switch the product off (expect 200, isActive false)
POST {{host}}/api/admin/products/{{newProduct.response.body.$.code}}/deactivate
Authorization: Bearer {{superLogin.response.body.$.token}}

### 86. The public catalogue no longer shows it (expect 404, no token needed)
GET {{host}}/api/products/{{newProduct.response.body.$.code}}

### 87. A quote cannot be made for a switched-off product (expect 400, "Unknown or unavailable product.")
POST {{host}}/api/quotes
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.$.token}}

{
  "customerId": {{quoteCustomer.response.body.$.id}},
  "productCode": "{{newProduct.response.body.$.code}}",
  "coverageAmount": 1000,
  "requestedEffectiveDate": "{{effectiveDate}}",
  "answers": {}
}

### 88. Switch it back on (expect 200, isActive true)
POST {{host}}/api/admin/products/{{newProduct.response.body.$.code}}/activate
Authorization: Bearer {{superLogin.response.body.$.token}}

### 89. The public catalogue shows it again (expect 200, no questions yet)
GET {{host}}/api/products/{{newProduct.response.body.$.code}}

### 90. Switch it off again, so test products do not pile up in the catalogue (expect 200, isActive false)
POST {{host}}/api/admin/products/{{newProduct.response.body.$.code}}/deactivate
Authorization: Bearer {{superLogin.response.body.$.token}}



