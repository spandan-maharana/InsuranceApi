PUT {{host}}/api/admin/products/NOPE
Content-Type: application/json
Authorization: Bearer {{superLogin.response.body.$.token}}

{
  "categoryCode": "SPECIALIZED",
  "name": "Nope",
  "coverageLabel": "Value",
  "ratePerThousand": 9,
  "minimumPremium": 100,
  "policyFee": 20,
